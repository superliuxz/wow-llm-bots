{
  "post-commit-review": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/post_commit_review.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/post_commit_review.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
