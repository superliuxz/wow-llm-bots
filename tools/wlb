#!/usr/bin/env -S python3 -I
"""wlb: the project's one command-line tool (build, run, check, set up).

  tools/wlb build common [VARIANT] [--no-tests] | server [--test]   (--test: out/server-test)
  tools/wlb db start | stop | backup [--keep N]
  tools/wlb config [TEST]                render out/server/etc/*.conf (TEST: config/tests/TEST.*)
  tools/wlb server start | stop [--test]   (--test: the isolated test server)
  tools/wlb console [--test] COMMAND...   send a command to worldserver's console
  tools/wlb check [format|includes|snapshots|triggers|rules|goldens|sanitizers] [--san] [--fix] [FILES...]
  tools/wlb test unit [--filter PATTERN] [--variant asan|tsan|msan]
  tools/wlb test e2e|perf|eval [NAME...]  [--keep-server]   (e2e/perf: the isolated test server)
  tools/wlb test perf [--update-baselines [--verify]] | --capture   (perf: record the numbers, and
                                                                     check they reproduce / the replay input)
  tools/wlb test --list
  tools/wlb setup links|configure|data|llama|msan|client-ui
  tools/wlb llm [--slots N] [--ctx N] [--model FILE] [-- llama-server args...]
  tools/wlb harness [run|decide ...]     build and run the C++ brain harness (default: run)
  tools/wlb remote list | <name> sync|status|run|pull|stop|install-hook  run on a remote worker (private/remotes.json)

`tools/wlb <command> --help` says more. Python standard library only.
"""

import argparse
import os
import pathlib
import sys

# -I (isolated) leaves the script's own directory off the path: add the tools directory.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from wlblib import build, check, common, llm, remote, server, setup, testing  # noqa: E402
from wlblib.common import OUT, main_guard  # noqa: E402


def parse(argv):
    parser = argparse.ArgumentParser(prog="tools/wlb", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("build", help="build common/ or the server")
    p.add_argument("what", choices=["common", "server"])
    p.add_argument("variant", nargs="?", default="default", choices=list(build.VARIANTS),
                   help="for common: default, asan, tsan, msan or server")
    p.add_argument("--no-tests", action="store_true", help="for common: don't run unit tests")
    p.add_argument("--test", action="store_true",
                   help="for server: the isolated test server's build in out/server-test (the "
                        "module's test-only code compiled in)")

    p = sub.add_parser("db", help="the project-local MySQL")
    p.add_argument("action", choices=["start", "stop", "backup"])
    p.add_argument("--keep", type=int, default=14, help="for backup: how many to keep")

    p = sub.add_parser("config", help="render the server's config from config/*.overrides")
    p.add_argument("test", nargs="?", help="a test config: config/tests/TEST.*.overrides")

    p = sub.add_parser("server", help="start or stop MySQL, authserver and worldserver")
    p.add_argument("action", choices=["start", "stop", "sample"])
    p.add_argument("--test", action="store_true",
                   help="the isolated test server (out/server-test) instead of the play server")
    p.add_argument("args", nargs="*", help=argparse.SUPPRESS)  # sample OUT INTERVAL ACCOUNT

    p = sub.add_parser("console", help="send a command to the worldserver console")
    p.add_argument("--test", action="store_true", help="the test server's console")
    p.add_argument("words", nargs="+")

    p = sub.add_parser("check", help="what code must pass before review or commit")
    p.add_argument("what", nargs="?", default="all",
                   choices=["all", "format", "includes", "snapshots", "triggers", "rules",
                            "goldens", "sanitizers"])
    p.add_argument("--sanitizers", "--san", "--full", dest="sanitizers", action="store_true",
                   help="for all: also build and run ASan+UBSan, TSan, and MSan")
    p.add_argument("--fix", action="store_true", help="for format, includes and rules: rewrite files")
    p.add_argument("files", nargs="*", help="for snapshots: files to validate")

    p = sub.add_parser("test", help="unit, e2e, perf and eval tests")
    p.add_argument("target", nargs="?", choices=list(testing.TARGETS))
    p.add_argument("names", nargs="*", help="e2e, perf, eval: the cases to run (default: all)")
    p.add_argument("--list", action="store_true", help="list the cases")
    p.add_argument("--filter", help="unit: a gtest filter, e.g. 'PlanTest.*'")
    p.add_argument("--variant", default="default", choices=list(build.VARIANTS),
                   help="unit: the build (default, asan, tsan, msan)")
    p.add_argument("--keep-server", action="store_true",
                   help="leave the test server running afterwards (tools/wlb server stop --test)")
    p.add_argument("--update-baselines", action="store_true",
                   help="perf: record this run's numbers as the new baselines")
    p.add_argument("--verify", action="store_true",
                   help="perf, with --update-baselines: run again right after and check against it")
    p.add_argument("--capture", action="store_true",
                   help="perf: record 5 minutes of live snapshots (the brain replay's input)")
    p.add_argument("--model", help="eval: a model file in models/ (default: $MODEL or the 35B)")
    p.add_argument("--shootout", action="store_true",
                   help="eval: run the same cases across every candidate model in models/")
    p.add_argument("--minutes", type=float, default=5.0,
                   help="soak: duration in minutes per run (default: 5.0)")
    p.add_argument("--runs", type=int, default=2,
                   help="soak: number of runs to average (default: 2)")
    p.add_argument("--suite", default="varied",
                   help="soak: scenario suite (varied, heldout, quest, or a scenario name)")
    p.add_argument("--score", action="store_true",
                   help="soak: print composite 0-100 human-likeness score + guardrails")
    p.add_argument("--human-dir", type=pathlib.Path, default=None,
                   help="soak: directory containing human/ baseline traces")
    p.add_argument("--judge", action="store_true",
                   help="soak: also run anonymized LLM human-vs-bot clip judge")
    p.add_argument("--verify-hash", type=pathlib.Path, default=None,
                   help="soak: verify scorer SHA-256 against lock file before running")

    p = sub.add_parser("setup", help="one-time setup steps")
    p.add_argument("step", choices=["links", "configure", "data", "llama", "msan", "client-ui"])

    p = sub.add_parser("llm", help="run llama-server with the brain's model")
    p.add_argument("--slots", type=int, default=16)
    p.add_argument("--ctx", type=int, default=4096, help="context per slot")
    p.add_argument("--model", help="a file in models/ (default: $MODEL or the 35B)")
    p.add_argument("extra", nargs=argparse.REMAINDER, help="after --: llama-server arguments")

    p = sub.add_parser("harness", help="build and run the C++ brain harness")
    p.add_argument("args", nargs=argparse.REMAINDER,
                   help="subcommand and flags (default: run)")

    p = sub.add_parser("remote", help="sync, build, and run commands on a remote CPU worker (private/remotes.json)")
    p.add_argument("target", help="'list' or a remote name from private/remotes.json")
    p.add_argument("action", nargs="?",
                   choices=["sync", "status", "run", "pull", "stop", "install-hook"],
                   help="action to run on the remote")
    p.add_argument("--force", action="store_true", help="sync: re-sync and rebuild even if stamp matches")
    p.add_argument("--no-sync", action="store_true", help="run: skip pre-flight sync/build check")
    p.add_argument("--no-tunnel", action="store_true",
                   help="run: do not reverse-tunnel local llama-server port")
    p.add_argument("--no-server-build", action="store_true",
                   help="sync/run: build common only (skip server-test)")
    p.add_argument("--pull", action="append", default=[], metavar="REMOTE_REL:LOCAL_PATH",
                   help="run: copy remote repo file back after command finishes (repeatable)")
    p.add_argument("cmd", nargs=argparse.REMAINDER,
                   help="for run: command to execute; for pull: REMOTE_REL LOCAL_PATH")
    return parser.parse_args(argv)


def main():
    a = parse(sys.argv[1:])
    if a.command == "build":
        if a.what == "common":
            build.common(a.variant, tests=not a.no_tests)
        else:
            build.server(test=a.test)
    elif a.command == "db":
        {"start": server.db_start, "stop": server.db_stop,
         "backup": lambda: server.db_backup(a.keep)}[a.action]()
    elif a.command == "config":
        server.config(a.test)
    elif a.command == "server":
        inst = common.TEST if a.test else common.PLAY
        if a.action == "start":
            server.server_start(inst)
        elif a.action == "stop":
            server.server_stop(inst=inst)
        else:
            server.sample(*a.args)
    elif a.command == "console":
        server.console(" ".join(a.words), inst=common.TEST if a.test else common.PLAY)
    elif a.command == "check":
        if a.what == "all":
            check.all_(with_sanitizers=a.sanitizers)
        elif a.what == "sanitizers":
            check.sanitizers()
        elif a.what == "format":
            check.format_(fix=a.fix)
        elif a.what == "includes":
            check.includes(fix=a.fix)
        elif a.what == "snapshots":
            check.snapshots(a.files)
        elif a.what == "triggers":
            check.triggers()
        elif a.what == "rules":
            check.rules(fix=a.fix)
        else:
            check.goldens()
    elif a.command == "test":
        if a.list or not a.target:
            testing.list_cases()
        elif a.target == "unit":
            testing.unit(a.variant, a.filter)
        elif a.target == "e2e":
            testing.e2e(a.names, a.keep_server)
        elif a.target == "perf" and a.capture:
            testing.capture_snapshots()
        elif a.target == "perf":
            testing.perf(a.names, a.keep_server, a.update_baselines, a.verify)
        elif a.target == "soak":
            testing.soak(
                minutes=a.minutes,
                runs=a.runs,
                score=a.score,
                human_dir=a.human_dir,
                judge=a.judge,
                verify_hash=a.verify_hash,
                suite=a.suite,
            )
        else:
            testing.eval_(a.names, model=a.model, shootout=a.shootout)
    elif a.command == "setup":
        getattr(setup, a.step.replace("-", "_"))()
    elif a.command == "llm":
        extra = a.extra[1:] if a.extra[:1] == ["--"] else a.extra
        llm.serve(a.slots, a.ctx, a.model, extra)
    elif a.command == "harness":
        build.common("default", tests=False)
        hargs = a.args[1:] if a.args[:1] == ["--"] else a.args
        if not hargs or hargs[0].startswith("--"):
            hargs = ["run", *hargs]
        bin_path = str(OUT / "common" / "harness")
        os.execv(bin_path, [bin_path, *hargs])
    elif a.command == "remote":
        if a.target == "list":
            remote.list_remotes()
            return
        if not a.action:
            raise common.Failed("tools/wlb remote <name> requires an action: sync|status|run|pull|stop|install-hook")
        extra_opts, cmd = remote.split_action_flags(a.cmd)
        force = a.force or extra_opts["force"]
        no_sync = a.no_sync or extra_opts["no_sync"]
        no_tunnel = a.no_tunnel or extra_opts["no_tunnel"]
        no_server_build = a.no_server_build or extra_opts["no_server_build"]
        pulls = [*a.pull, *extra_opts["pull"]]
        if a.action == "sync":
            remote.sync(a.target, force=force, server_build=not no_server_build)
        elif a.action == "status":
            remote.status(a.target)
        elif a.action == "stop":
            remote.stop(a.target)
        elif a.action == "install-hook":
            remote.install_hook(a.target)
        elif a.action == "pull":
            if len(cmd) != 2:
                raise common.Failed("usage: tools/wlb remote <name> pull REMOTE_REL LOCAL_PATH")
            remote.pull(a.target, cmd[0], cmd[1])
        else:
            remote.run_remote(
                a.target, cmd,
                no_sync=no_sync,
                no_tunnel=no_tunnel,
                server_build=not no_server_build,
                pulls=pulls,
            )


if __name__ == "__main__":
    main_guard(main)
