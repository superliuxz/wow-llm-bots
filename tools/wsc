#!/usr/bin/env bash
# Send a command to the worldserver console and show the new log output.
# Usage: tools/wsc account create <name> <password>
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT=$ROOT/var/logs/worldserver.out
n=$(wc -l < "$OUT")
PIPE=$ROOT/out/server/run/worldserver.stdin
PID=$ROOT/out/server/run/worldserver.pid
# Writing to the console pipe blocks until worldserver reads it: never write when it isn't running.
if ! { [ -p "$PIPE" ] && [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }; then
  echo "worldserver isn't running (tools/server-start.sh)" >&2; exit 1
fi
timeout 5 bash -c 'echo "$1" > "$2"' _ "$*" "$PIPE"
sleep 1
tail -n +"$((n + 1))" "$OUT"
