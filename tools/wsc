#!/usr/bin/env bash
# Send a command to the worldserver console and show the new log output.
# Usage: tools/wsc account create will mypassword
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT=$ROOT/out/server/logs/worldserver.out
n=$(wc -l < "$OUT")
echo "$*" > "$ROOT/out/server/run/worldserver.stdin"
sleep 1
tail -n +"$((n + 1))" "$OUT"
