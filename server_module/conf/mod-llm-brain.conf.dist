[worldserver]

########################################
# mod-llm-brain configuration
########################################
#
#    LlmBrain.Enable
#        Description: Enable the LLM brain bridge (snapshots out, commands in).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

LlmBrain.Enable = 0

#
#    LlmBrain.SocketPath
#        Description: Unix socket the harness connects to.
#        Default:     "brain.sock" (relative to the worldserver working directory)

LlmBrain.SocketPath = "brain.sock"

#
#    LlmBrain.Bots
#        Description: Comma-separated character names our bot manager keeps logged in and
#                     the brain controls (phase 2: one bot). Requires
#                     Playerbots.RandomBotAutologin = 0 (our manager replaces playerbots'
#                     random-bot manager).
#        Default:     ""

LlmBrain.Bots = ""

#
#    LlmBrain.SnapshotIntervalMs
#        Description: How often each attached bot's snapshot is streamed to the harness.
#                     The bots are spread over the interval (bot i of N is first due i/N of an
#                     interval after the start), so the work is never one burst per interval.
#                     The harness decides when to call the LLM (only when there is something
#                     to act on, plus its own fallback timer); snapshots alone cost no LLM time.
#        Default:     1000
#
#    LlmBrain.SnapshotIntervalCombatMs
#        Description: The same, for a bot in combat: a fight changes in a fraction of a second.
#                     A bot whose combat or life state changed is sent a snapshot at once,
#                     whatever its interval. 0, or not shorter than SnapshotIntervalMs: no
#                     faster cadence.
#        Default:     250

LlmBrain.SnapshotIntervalMs = 1000
LlmBrain.SnapshotIntervalCombatMs = 250

#
#    LlmBrain.NameplateRangeYd
#        Description: How far names and nameplate fields show in a snapshot's `nearby`
#                     (the client's nameplate distance: 20 default, up to 41). Beyond it,
#                     units carry only what their model shows. Later a per-bot UI setting.
#        Default:     20
#
#    LlmBrain.LosRaycastsPerSnapshot
#        Description: Line-of-sight ray casts per bot per snapshot (nearest first, results
#                     cached 1 s near / 5 s far). Bounds the world-thread cost of `nearby`.
#        Default:     32

LlmBrain.NameplateRangeYd = 20
LlmBrain.LosRaycastsPerSnapshot = 32

#
#    LlmBrain.CombatStrategies
#    LlmBrain.NonCombatStrategies
#    LlmBrain.DeadStrategies
#        Description: Playerbots strategy changes the bot manager applies to our bots and
#                     re-applies whenever playerbots resets them. The defaults give our bots
#                     what playerbots gives a solo random bot: they quest and grind on their
#                     own (docs/playerbots-random-bot-audit.md). Healers also get the solo
#                     damage strategies for their spec.
#        Default:     "+boost,+dps assist,-threat"
#                     "-follow,+grind,+new rpg"
#                     "-follow"

LlmBrain.CombatStrategies = "+boost,+dps assist,-threat"
LlmBrain.NonCombatStrategies = "-follow,+grind,+new rpg"
LlmBrain.DeadStrategies = "-follow,-stay"

#
#    LlmBrain.TestFixtures
#        Description: TEST ONLY. Characters to reset at startup from player dumps, as
#                     "Name=file.pdump,Name2=other.pdump" (files relative to
#                     LlmBrain.FixtureDir). Each is erased and recreated before the bot
#                     manager logs it in, so every test run starts from the same state.
#                     Only characters on LlmBrain.TestAccount are ever erased; the account
#                     is created if missing. Leave empty outside tests.
#        Default:     ""
#
#    LlmBrain.FixtureDir
#        Description: Directory of the fixture files (server_module/testdata/characters).
#        Default:     ""
#
#    LlmBrain.TestFactsQueries
#        Description: TEST ONLY. A file of eval-fixture queries; at startup the module
#                     writes each fixture's OptionFacts with its own code
#                     (tools/snapshot/add_fixture_options.py --capture). Test builds only.
#        Default:     ""
#
#    LlmBrain.TestAccount
#        Description: Account that holds the test characters.
#        Default:     "WLBTEST"

LlmBrain.TestFixtures = ""
LlmBrain.FixtureDir = ""
LlmBrain.TestAccount = "WLBTEST"
LlmBrain.TestFactsQueries = ""

#    LlmBrain.TraceDir
#        Description: Directory for unified JSONL behavior traces (empty
#                     disables both bot tracing and ObserveHumans).
#        Default:     ""
#
#    LlmBrain.ObserveHumans
#        Description: Sample online human (non-bot) players into
#                     LlmBrain.TraceDir (under human/<name>/) for human-baseline
#                     scoring. Off by default; requires LlmBrain.TraceDir to be
#                     non-empty. Records 5 Hz kinematics/state samples (position,
#                     facing, HP/mana/XP, hostile target state, bag free slots)
#                     and server gameplay events (combat, casts, damage/heals,
#                     kills, deaths, quests, loot, items, money/rep deltas,
#                     zone/area changes, group join/leave). Does NOT record raw
#                     keystrokes/client opcodes, other players' names in social
#                     or PvP events, or whisper text (whispers log timing and
#                     byte length only).
#        Default:     0
#
#    LlmBrain.TraceSampleIntervalMs
#        Description: Minimum interval between periodic trace samples (ms),
#                     plus immediate samples on combat/jump transitions.
#                     trace_parity.py rejects traces whose measured median rate
#                     is below 3.5 Hz; world-tick rounding adds up to one tick
#                     (~50 ms) on top of this setting, and the module warns at
#                     runtime if the measured rate in the trace drops below
#                     3.5 Hz, so keep the default 200 ms whenever traces are
#                     scored. Use the two caps below, not this interval, to
#                     bound disk volume.
#        Default:     200
#
#    LlmBrain.TraceMaxFileMb
#    LlmBrain.TraceMaxRotatedFiles
#        Description: Per-character, per-day volume cap. Each day file rotates
#                     at TraceMaxFileMb and keeps TraceMaxRotatedFiles archives
#                     (oldest overwritten; 0 = truncate in place), so one
#                     character's day is at most
#                     TraceMaxFileMb * (TraceMaxRotatedFiles + 1) MB.
#        Default:     64, 8

LlmBrain.TraceDir = ""
LlmBrain.TraceSampleIntervalMs = 200
LlmBrain.TraceMaxFileMb = 64
LlmBrain.TraceMaxRotatedFiles = 8
LlmBrain.ObserveHumans = 0
