DataDir = "@ROOT@/server/data"
# PvE realm (decided). Horde only: disable Alliance character creation.
GameType = 0
CharacterCreating.Disabled = 1
# Save characters every 60 s (state sampling for evals: bots and the user's human baseline).
PlayerSaveInterval = 60000
# Chat log for evals (bot chat + the user's human baseline). Flags 5 = timestamp + filter type.
Appender.Chat = 2,4,5,Chat.log,a
Logger.chat.say = 4,Chat
Logger.chat.emote = 4,Chat
Logger.chat.yell = 4,Chat
Logger.chat.whisper = 4,Chat
Logger.chat.party = 4,Chat
Logger.chat.raid = 4,Chat
Logger.chat.guild = 4,Chat
Logger.chat.guild.officer = 4,Chat
Logger.chat.channel = 4,Chat
# No automated Dungeon Finder (decided, inspired by WoW Forever): groups form socially
# via chat ("LF2M Deadmines"). Keep the Raid Browser (manual listing board) and
# seasonal bosses. Mask: 1 dungeon finder, 2 raid browser, 4 seasonal bosses.
DungeonFinder.OptionsMask = 6
