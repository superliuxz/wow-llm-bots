# The client data the play build extracted (tools/wlb setup data); the test server shares it.
DataDir = "@ROOT@/out/server/data"
# 8085 for the play server, 8086 for the test server (tools/wlblib/common.py).
WorldServerPort = @WORLD_PORT@
# PvE realm (decided). Horde only: disable Alliance character creation.
GameType = 0
CharacterCreating.Disabled = 1
# Save characters every 60 s (state sampling for evals: bots and the user's human baseline).
PlayerSaveInterval = 60000
# Chat log for evals (bot chat + the user's human baseline). Flags 5 = timestamp + filter type.
Appender.Chat = 2,4,5,Chat.log,a
Logger.chat.say = 4,Chat
Logger.chat.emote = 4,Chat
Logger.chat.yell = 4,Chat
Logger.chat.whisper = 4,Chat
Logger.chat.party = 4,Chat
Logger.chat.raid = 4,Chat
Logger.chat.guild = 4,Chat
Logger.chat.guild.officer = 4,Chat
Logger.chat.channel = 4,Chat
# Dungeon Finder on (revised 2026-11-15; it is part of 3.3.5a). Each bot's brain decides
# whether to queue or to form groups in chat. Mask: 1 dungeon finder, 2 raid browser,
# 4 seasonal bosses.
DungeonFinder.OptionsMask = 7
# LookingForGroup channel usable anywhere and without queueing (decided 2026-11-24), so the user
# and the bots can form pugs in chat ("LFM RFC need heals"), as on most 3.3.5a servers.
# AzerothCore's defaults (0 / 1) keep it to cities and to players queued in Dungeon Finder.
LFG.Location.All = 1
Channel.RestrictedLfg = 0
