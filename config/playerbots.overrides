PlayerbotsDatabaseInfo = "127.0.0.1;3306;acore;@DB_PASSWORD@;acore_playerbots"
# No cheats or shortcuts: bots play like humans (docs/design.md).
Playerbots.BotCheats = ""
Playerbots.AutoLearnTrainerSpells = 0
Playerbots.AutoLearnQuestSpells = 0
Playerbots.AutoPickTalents = 0
Playerbots.AutoUpgradeEquip = 0
Playerbots.AutoEquipUpgradeLoot = 0
Playerbots.AutoTeleportForLevel = 0
Playerbots.AutoGearCommand = 0
Playerbots.ReviveBotWhenSummoned = 0
# The random-bot manager is off: our module's bot manager decides who is online
# (mod-llm-brain LlmBrain.Bots; docs/playerbots-random-bot-audit.md). Off means no random
# picking, rotation, refresh / revive, teleports or re-randomizing.
Playerbots.RandomBotAutologin = 0
Playerbots.MinRandomBots = 0
Playerbots.MaxRandomBots = 0
# Its login hook still runs for bots without a master: no automatic bot guilds or arena
# teams (bots form guilds themselves).
Playerbots.RandomBotGuildCount = 0
Playerbots.RandomBotArenaTeam2v2Count = 0
Playerbots.RandomBotArenaTeam3v3Count = 0
Playerbots.RandomBotArenaTeam5v5Count = 0
# Our bots are "real players": always active, no sleeping/rotation when no human is nearby.
# (Default 10% active-alone + smart scaling made the test bot sleep ~90% of the time.)
Playerbots.BotActiveAlone = 100
Playerbots.botActiveAloneSmartScale = 0
# The random-bot manager must not queue bots by itself: queueing is each bot's own choice
# (its brain), like a player. The Dungeon Finder itself is on (worldserver.overrides).
Playerbots.RandomBotJoinLfg = 0
