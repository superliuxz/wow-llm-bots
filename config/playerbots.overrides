PlayerbotsDatabaseInfo = "127.0.0.1;3306;acore;@DB_PASSWORD@;acore_playerbots"
# No cheats or shortcuts: bots play like humans (docs/design.md).
Playerbots.BotCheats = ""
Playerbots.AutoLearnTrainerSpells = 0
Playerbots.AutoLearnQuestSpells = 0
Playerbots.AutoPickTalents = 0
Playerbots.AutoUpgradeEquip = 0
Playerbots.AutoEquipUpgradeLoot = 0
Playerbots.AutoTeleportForLevel = 0
Playerbots.AutoGearCommand = 0
Playerbots.ReviveBotWhenSummoned = 0
# All Horde. No random bots until the phase 1 tests.
Playerbots.RandomBotAllianceRatio = 0
Playerbots.RandomBotHordeRatio = 100
Playerbots.MinRandomBots = 0
Playerbots.MaxRandomBots = 0
# No hidden cheats from the random-bot manager: no auto-revive (bots must corpse-run),
# no periodic random teleports, no level/gear re-randomizing.
Playerbots.MinRandomBotReviveTime = 31536000
Playerbots.MaxRandomBotReviveTime = 31536000
Playerbots.MinRandomBotTeleportInterval = 31536000
Playerbots.MaxRandomBotTeleportInterval = 31536000
Playerbots.MinRandomBotRandomizeTime = 31536000
Playerbots.MaxRandomBotRandomizeTime = 31536000
# Our bots are "real players": always active, no sleeping/rotation when no human is nearby.
# (Default 10% active-alone + smart scaling made the test bot sleep ~90% of the time.)
Playerbots.BotActiveAlone = 100
Playerbots.botActiveAloneSmartScale = 0
