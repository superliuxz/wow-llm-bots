# Template: tools/wlb db start renders it to out/server/etc/mysql.cnf, with the repo root filled in.
[mysqld]
datadir=@ROOT@/var/mysql-data
socket=@ROOT@/out/server/run/mysql.sock
pid-file=@ROOT@/out/server/run/mysqld.pid
log-error=@ROOT@/var/logs/mysql.log
bind-address=127.0.0.1
port=3306
skip-name-resolve
mysqlx=OFF
secure-file-priv=@ROOT@/var/mysql-files
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
max_connections=300
innodb_buffer_pool_size=2G

[client]
socket=@ROOT@/out/server/run/mysql.sock
