# e2e_human_party: a real (scripted) Alliance human client invites fresh Alliance bots at the
# Northshire Abbey start (reset on every server start). Needs a test build.
LlmBrain.Bots = "Loada,Loadb,Loadc"
LlmBrain.TestFixtures = "Loada=new:human:paladin,Loadb=new:human:priest,Loadc=new:human:mage"
LlmBrain.NonCombatStrategies = "-follow,-grind,-new rpg"
LlmBrain.TraceDir = "@RUN@/traces"
LlmBrain.ObserveHumans = 1
