# Whisper test: two fresh level-1 Troll Priests at the Valley of Trials start (reset from the
# fixture on every server start), standing still (no grind, no new rpg). The scripted brain
# (`tools/wlb snap fake --whisper`) makes one whisper the other and the other answer,
# through the module's Say command; each must hear the other through the whisper hook. Needs a
# test build (tools/wlb build server --test).
LlmBrain.Bots = "Loada,Telda"
LlmBrain.TestFixtures = "Loada=priest-l1-valley.pdump,Telda=priest-l1-valley.pdump"
LlmBrain.FixtureDir = "@ROOT@/server_module/testdata/characters"
LlmBrain.NonCombatStrategies = "-follow,-grind,-new rpg"
