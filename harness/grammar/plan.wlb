// The brain's reply, a plan (docs/specs/triggers.md): the one source of its
// line format. tools/grammar/wlb_gen.py generates the types, parser, printer
// and GBNF (docs/plans/grammar-idl.md); RULES.md's reply form comes from the
// descriptions here. The hand-written hooks are in plan_hooks.{h,cc}.

import "orders.wlb"

env PlanEnv {
  options: count;       // the screen's options: 1..N
  whisperers: names;    // who `tell` may answer (none: no tell line)
  hover_names: names;   // what `hover:` may name (none: no hover line)
  order_names: names;   // what `order:` lines may name (none: no order lines)
}

int   Option  1..options
int   Repeat  2..29
int   Look    10..999 @parse(LookSeconds)       // also "60s", "2m"
int   Pct     1..99
int   Yards   1..999
text  Goal    max 60 no "\n"
text  Chat    max 80 no "\n|"
name  Player  from whisperers @parse(CapitalizedName)  // 2-12 letters
text  Hover   max 60 no "\n|" from hover_names
words Panel   { bags, character, "quest log" ~"questlog" }

struct Step = option:Option ("x" times:Repeat)?;

choice Watch {
  Hp          = "hp<" pct:Pct;
  Mana        = "mana<" pct:Pct;
  EnemyPlayer = "enemy_player<" yd:Yards;
  Attacked    = "attacked";
  Whisper     = "whisper";
}

lines Plan {
  do: steps:list<Step, ", ", 1..5> @normalize(NormalizeSteps)
      "<option numbers in order; add xN to repeat 2-29 times, e.g. 3x4>";
  expect: expect:list<Option, ", ", 1..5> default "none" @normalize(NormalizeSteps)
      "<option numbers of the mobs this plan fights, or none>";
  watch: watches:list<Watch, ", ", 1..4> default "none" @normalize(NormalizeWatches)
      "<none, or up to 4 of: hp<N, mana<N, enemy_player<YARDS, attacked, whisper>";
  look: look_s:Look @normalize(NormalizeSteps)
      "<integer 60 to 300: a safety net only, since surprises wake you at once>";
  goal?: goal:Goal default "none"
      "<optional: what you're working towards, a few words>";
  say?: say:Chat
      "<optional: a line said out loud to the players near you>";
  tell? <tell_to:Player "Name">: tell:Chat
      "<optional: a whisper to one player by name; answer a whisper this way>";
  open?: open:list<Panel, ", ", 1..3> default "none" lenient
      "<optional: bags, character and/or quest log, to look at them; you are woken again once they show>";
  close?: close:list<Panel, ", ", 1..3> default "none" lenient
      "<optional: panels to close>";
  hover?: hover:Hover default "none"
      "<optional: the name of an item or quest on your screen, to read its tooltip; you are woken again>";
  order*7: orders:Order @needs(order_names);
}
